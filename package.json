{
  "name": "unclutterdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Unclutter Desk — Multi-Tenant Practice Management SaaS for Therapists & Clinics",
  "scripts": {
    "dev": "pnpm --parallel --filter @unclutterdesk/api --filter @unclutterdesk/app --filter @unclutterdesk/landing run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
