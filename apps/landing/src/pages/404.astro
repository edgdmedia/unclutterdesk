---
import '../styles/global.css';

// Astro emits this as 404.html, which Cloudflare Pages serves with a real 404
// status for unmatched paths — replacing the soft 404 where every unknown URL
// returned 200 with the home page.
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.unclutterdesk.com';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Page not found · Unclutter Desk</title>
  </head>
  <body class="antialiased bg-white">
    <header class="border-b border-slate-200">
      <div class="max-w-[880px] mx-auto px-5 md:px-8 h-[72px] flex items-center justify-between">
        <a href="/" class="flex items-center">
          <img src="/unclutterdesk-lockup.svg" alt="Unclutter Desk" class="h-7 w-auto object-contain" />
        </a>
        <a href={appUrl} class="text-[14px] font-semibold text-[#0F3A53] hover:underline">Sign in</a>
      </div>
    </header>

    <main class="max-w-[880px] mx-auto px-5 md:px-8 py-20 md:py-28">
      <p class="m-0 text-[12px] font-bold tracking-[0.14em] text-[#64748B] uppercase">Error 404</p>
      <h1 class="mt-3 mb-4 text-[34px] md:text-[42px] leading-[1.15] font-extrabold text-[#0F172A]">
        We couldn't find that page
      </h1>
      <p class="m-0 mb-8 text-[16px] leading-[1.7] text-[#334155] max-w-[560px]">
        The link may be out of date, or the address may have a typo in it.
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex items-center justify-center h-[48px] px-6 rounded-[14px] bg-[#0F3A53] text-white text-[15px] font-bold hover:opacity-90 transition-opacity"
        >
          Back to home
        </a>
        <a
          href={appUrl}
          class="inline-flex items-center justify-center h-[48px] px-6 rounded-[14px] border border-slate-300 text-[#0F172A] text-[15px] font-bold hover:bg-slate-50 transition-colors"
        >
          Go to the app
        </a>
      </div>

      <p class="mt-12 mb-0 text-[14px] text-[#64748B]">
        Looking for a practice's booking page? Those live at their own address,
        like <span class="font-semibold text-[#334155]">practice-name.unclutterdesk.com</span>.
      </p>
    </main>

    <footer class="bg-[#0F172A] mt-16 py-10 px-5 md:px-8">
      <div class="max-w-[880px] mx-auto flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <img src="/unclutterdesk-lockup.svg" alt="Unclutter Desk" class="h-7 w-auto object-contain brightness-0 invert" />
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-[14px]">
          <a href="/" class="text-white hover:text-[#94A3B8] transition-colors">Home</a>
          <a href="/terms" class="text-white hover:text-[#94A3B8] transition-colors">Terms</a>
          <a href="/privacy" class="text-white hover:text-[#94A3B8] transition-colors">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
