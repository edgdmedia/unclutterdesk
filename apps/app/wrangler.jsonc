{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The app on therapysts.app, in the Therapysts account: the built files
  // (Workers Static Assets), plus src/edge/worker.ts for the paths in
  // run_worker_first, which on therapysts.app are the Desk's home and pricing
  // from the profiles Worker (its DeskSite entrypoint, same account).
  "name": "therapysts-app",
  "main": "./src/edge/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Desk home's pages and the profiles build's own files (/_astro, /themes.css).
    "run_worker_first": ["/", "/pricing", "/_astro/*", "/themes.css", "/site.webmanifest"],
    // Any path that isn't a file gets index.html, so client routes load.
    "not_found_handling": "single-page-application"
  },
  // The tenant router fetches the app shell for practice subdomains from
  // therapysts-app.therapysts.workers.dev (ORIGIN_HOST in apps/tenant-router).
  "workers_dev": true,
  "services": [{ "binding": "DESK_SITE", "service": "therapysts-profiles", "entrypoint": "DeskSite" }],
  "vars": { "APP_HOST": "therapysts.app" },
  "routes": [{ "pattern": "therapysts.app", "custom_domain": true }]
}
