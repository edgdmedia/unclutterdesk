# Cloudflare Pages security headers for app.unclutterdesk.com and every
# <tenant>.unclutterdesk.com booking surface.
#
# Files in public/ are copied verbatim into dist/, which is what wrangler
# deploys. `_headers` is parsed by Pages and never served as an asset.
#
# NOTE: these do not apply to Pages Functions responses. This project has no
# functions/ directory, so every response is a static asset and is covered.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  # Telehealth opens the provider room (Jitsi/Daily) in a NEW TAB, so this origin
  # itself never needs camera or microphone. If the in-app telehealth shell at
  # /session/:id is ever wired to real media, change these to (self).
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Report-Only first — ON PURPOSE. A CSP that is wrong breaks Paystack/Stripe
  # checkout redirects silently and at the worst possible moment. Deploy this,
  # watch for violations in the browser console for a few real bookings, then
  # rename the header to `Content-Security-Policy` to enforce it.
  #
  # 'unsafe-inline' is present for style-src only: the built index.html has no
  # inline <style>, but component libraries commonly inject one at runtime.
  # script-src has no 'unsafe-inline' — the build emits only external modules.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://api.unclutterdesk.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# The service worker must not be cached, or clients pin an old bundle.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

# Vite emits content-hashed filenames, so these are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
