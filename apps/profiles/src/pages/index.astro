---
import SitePage from '../components/SitePage.astro';
import { config as loadConfig } from '../lib/env';
import { MISS_CACHE, PAGE_CACHE } from '../lib/security';
import { PLAN_BLURBS, fetchPlans, planHighlights, type Plan } from '../lib/plans';

/*
 * The site home (the design canvas's Home and HomeMobile boards).
 * Platform first, with the free profile as the way in:
 * the hero sells the practice software, "Start here" the free profile, and
 * pricing sits on the page. Plan prices and features come from the API (the
 * tables that set the charge and the limits), as on /pricing; if it can't be
 * reached the page still renders, without the plan cards.
 */
const config = loadConfig();
const address = config.publicOrigin.replace(/^https:\/\//, '');

let plans: Plan[] | null = null;
try {
  plans = await fetchPlans(config);
  Astro.response.headers.set('Cache-Control', PAGE_CACHE);
} catch {
  Astro.response.headers.set('Cache-Control', MISS_CACHE);
}
const highlights = plans ? planHighlights(plans) : [];
const lowestFree = plans?.find((p) => p.platformFeePercent === 0);
const BUTTONS: Record<Plan['tier'], string> = {
  FREE: 'Create your free profile',
  STARTER: 'Start with Starter',
  PRO: 'Choose Pro',
  CLINIC: 'Choose Clinic',
};

// The hero's sample day: two sessions at the seed practice's session fee (₦35,000).
const SESSION_FEE = 35_000;
const naira = (n: number) => `₦${n.toLocaleString('en-NG')}`;
const sample = { name: 'Dr. Folake Adeyemi', handle: 'folake' };
const initials = sample.name.replace(/^Dr\.\s*/, '').split(/\s+/).map((w) => w[0]).join('').slice(0, 2);

const features = [
  { t: 'Online booking', d: 'Your hours, services and fees. Clients pick a time straight from your profile.' },
  { t: 'Payments in naira', d: 'Paystack card payments on every plan, and bank transfer from Starter up.' },
  { t: 'Video sessions', d: 'A secure session link with every booking. No extra app for your clients.' },
  { t: 'Intake and consent', d: 'Forms clients fill before the first session, kept with their record.' },
  { t: 'Notes and assessments', d: 'Encrypted session notes, with PHQ-9 and GAD-7 scored for you.' },
  { t: 'Hours log', d: 'Every session logged for supervision and training requirements.' },
];
---
<SitePage
  title="Therapysts · Practice software for therapists, with a free profile"
  description="Get booked, get paid, and run your practice in one place: online booking, payments in naira, video sessions and client records. It starts with a free professional profile."
  canonical={`${config.publicOrigin}/`}
  fullNav
>
  <main id="main" class="home">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="home-hero-copy">
        <p class="eyebrow">For therapists, counsellors and psychologists</p>
        <h1 id="hero-title">Get booked, get paid, and run your practice in one place.</h1>
        <p class="lead">Online booking, payments in naira, video sessions and client records. It all starts with a free professional profile you'll be proud to share.</p>
        <p class="cta-row">
          <a class="btn btn-lg" href="/join">Start free with your profile</a>
          <a class="btn btn-lg secondary" href="#pricing">See pricing</a>
        </p>
        <p class="muted small">Free profile, forever · No card needed · Upgrade when the practice grows</p>
      </div>
      <div class="home-hero-art" aria-hidden="true">
        <div class="hero-dash">
          <span class="hero-dash-side">
            <svg width="22" height="22" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"><path d="M26 18 C28 42 42 58 64 61"/><path d="M74 18 C74 52 62 76 38 88"/></svg>
            <span class="on"></span><span></span><span></span><span></span>
          </span>
          <span class="hero-dash-main">
            <span class="hero-kicker">Sessions today</span>
            <span class="hero-row"><b>Adaeze Okonkwo</b><i>10:00 · Video</i></span>
            <span class="hero-row"><b>Ibrahim Sani</b><i>13:30 · In person</i></span>
            <span class="hero-paid"><span class="hero-kicker">Paid this month</span><b>{naira(SESSION_FEE * 2)}</b></span>
          </span>
        </div>
        <div class="hero-profile">
          <span class="hero-avatar">{initials}</span>
          <span class="hero-profile-text"><b>{sample.name}</b><i>{address}/{sample.handle}</i></span>
        </div>
      </div>
    </section>

    <section id="features" class="band" aria-labelledby="features-title">
      <div class="band-inner">
        <p class="eyebrow">Everything your practice runs on</p>
        <h2 id="features-title">One calm place for the work around your sessions, so you can spend your time with clients.</h2>
        <ol class="feature-grid">
          {features.map((f, i) => (
            <li>
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <h3>{f.t}</h3>
              <p class="muted">{f.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="profile" class="home-profile" aria-labelledby="profile-title">
      <div class="home-profile-art" aria-hidden="true">
        <div class="mock-card">
          <span class="mock-band"></span>
          <span class="mock-photo"></span>
          <span class="mock-name">Dr. Folake Adeyemi</span>
          <span class="mock-kind">Clinical Psychologist · Lagos</span>
          <span class="mock-line">Helping adults through anxiety, burnout and big life changes.</span>
          <span class="mock-chips"><span>Anxiety</span><span>Burnout</span><span>Grief</span></span>
          <span class="mock-btn">Book a session</span>
        </div>
      </div>
      <div class="home-profile-copy">
        <p class="eyebrow">Start here · free</p>
        <h2 id="profile-title">A professional profile in ten minutes</h2>
        <p class="lead">One link that tells clients who you are, your training and how you work. Send it instead of an Instagram page. When you switch on booking, clients book and pay from the same page.</p>
        <ol class="steps">
          <li><span class="step-n" aria-hidden="true">1</span><span><b>Pick a template</b> for your kind of practice, with prompts for every section.</span></li>
          <li><span class="step-n" aria-hidden="true">2</span><span><b>Make it look like you</b> with a layout and colour palette.</span></li>
          <li><span class="step-n" aria-hidden="true">3</span><span><b>Share your link</b> on WhatsApp, Instagram, a QR code or your email signature.</span></li>
        </ol>
        <p class="cta-row"><a class="btn btn-lg" href="/join">Create your free profile</a></p>
        <p class="muted small">Your address: {address}/yourname</p>
      </div>
    </section>

    <section id="pricing" class="band" aria-labelledby="pricing-title">
      <div class="band-inner">
        <h2 id="pricing-title">Start free. Upgrade when the practice grows.</h2>
        <p class="lead">{lowestFree ? `No commission on payments from ${lowestFree.name} up.` : 'Paid plans when the practice grows.'} <a href="/pricing">Compare plans</a></p>
        {plans && (
          <ul class="plans">
            {plans.map((p, i) => (
              <li class={`plan${p.tier === lowestFree?.tier ? ' plan-popular' : ''}`}>
                {p.tier === lowestFree?.tier && <span class="plan-flag">No commission</span>}
                <h3>{p.name}</h3>
                <p class="plan-price"><span>{p.monthlyPrice}</span> <span class="muted">{p.monthlyKobo ? '/ month' : 'forever'}</span></p>
                <p class="plan-blurb">{PLAN_BLURBS[p.tier]}</p>
                <ul class="plan-features">{highlights[i].map((f) => <li>{f}</li>)}</ul>
                <a class={p.tier === lowestFree?.tier ? 'btn wide' : 'btn secondary wide'} href="/join">{BUTTONS[p.tier]}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <section class="home-close" aria-labelledby="close-title">
      <h2 id="close-title">Your practice, in one calm place.</h2>
      <p class="lead">Start with your free profile today. Switch on booking whenever you're ready.</p>
      <p class="cta-row"><a class="btn btn-lg btn-sky" href="/join">Start free with your profile</a></p>
    </section>
  </main>
</SitePage>
