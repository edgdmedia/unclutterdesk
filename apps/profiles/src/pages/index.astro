---
import DeskHome from '../components/DeskHome.astro';
import ProfilesHome from '../components/ProfilesHome.astro';
import { config as loadConfig } from '../lib/env';
import { isDeskHost } from '../lib/config';

// One path, two homes: the Desk's on the app's domain, the profiles' here.
const desk = isDeskHost(Astro.url, loadConfig());
---
{desk ? <DeskHome /> : <ProfilesHome />}
