---
import Base from '../components/Base.astro';
import SitePage from '../components/SitePage.astro';
import ProfileView from '../components/ProfileView.astro';
import { config as loadConfig } from '../lib/env';
import { KIND_TITLES, lookupProfile, personJsonLd } from '../lib/profiles';
import { MISS_CACHE, PAGE_CACHE } from '../lib/security';
import { profileTag } from '../lib/purge';
import { profileTheme } from '@unclutterdesk/ui/src/brand/profileThemes';

const config = loadConfig();
const requested = Astro.params.handle ?? '';
// One address per profile: /Jane-Smith 301s to /jane-smith.
if (requested !== requested.toLowerCase()) return Astro.redirect(`/${requested.toLowerCase()}`, 301);
const result = await lookupProfile(config, requested);

if (result.kind === 'moved') {
  // Old handles 301 to the current one, forever (§6.2).
  return Astro.redirect(`/${result.handle}`, 301);
}
if (result.kind !== 'found') {
  Astro.response.status = result.kind === 'gone' ? 410 : 404;
  Astro.response.headers.set('Cache-Control', MISS_CACHE);
} else {
  Astro.response.headers.set('Cache-Control', PAGE_CACHE);
}
// Purged by tag when this profile changes (§6.12). A miss is tagged too, so
// a just-published profile replaces its cached 404 at once.
Astro.response.headers.set('Cache-Tag', profileTag(requested.toLowerCase()));
const profile = result.kind === 'found' ? result.profile : null;
const canonical = profile ? `${config.publicOrigin}/${profile.handle}` : undefined;
---
{profile ? (
  <Base
    title={`${profile.displayName} · ${KIND_TITLES[profile.kind] ?? 'Therapist'}`}
    description={profile.headline ?? undefined}
    canonical={canonical}
    theme={profileTheme(profile.themeKey).key}
    image={profile.previewImageUrl ?? profile.photoUrl}
    jsonLd={personJsonLd(profile, canonical!)}
  >
    <ProfileView profile={profile} config={config} />
  </Base>
) : (
  <SitePage title={result.kind === 'gone' ? 'Profile no longer available' : 'Profile not found'} noindex>
    <main id="main" class="wrap">
      {result.kind === 'gone' ? (
        <div class="card notice-page">
          <h1>This profile is no longer available</h1>
          <p class="muted">The therapist may have taken it down. If you were seeing them, contact them directly.</p>
          <p><a class="btn" href="/">Go to Therapysts</a></p>
        </div>
      ) : (
        <div class="card notice-page">
          <h1>We couldn’t find that profile</h1>
          <p class="muted">Check the spelling of the address. Profile addresses look like {config.publicOrigin.replace(/^https:\/\//, '')}/name.</p>
          <p><a href="/join">Create your own free profile</a></p>
        </div>
      )}
    </main>
  </SitePage>
)}
