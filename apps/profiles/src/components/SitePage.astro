---
/*
 * The frame for the site's own pages (home, report, not found, no longer
 * available): the Therapysts top bar and footer around the page content.
 * Profile pages use ProfileView instead, where the therapist leads.
 */
import Base from './Base.astro';
import lockup from '@unclutterdesk/ui/src/brand/therapysts/logos/therapysts-lockup.min.svg?url';
import { config as loadConfig } from '../lib/env';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  theme?: string;
  /** Show "Sign in" and "Create your profile" in the top bar (the home page). */
  fullNav?: boolean;
}
const { title, description, canonical, noindex = false, theme = 'calm', fullNav = false } = Astro.props;
const config = loadConfig();
---
<Base title={title} description={description} canonical={canonical} noindex={noindex} theme={theme}>
  <div class="site">
    <header class="site-top">
      <div class="site-top-inner">
        <a class="brand" href="/" aria-label="Therapysts home">
          <img src={lockup} alt="therapysts" width="146" height="36" />
        </a>
        {fullNav && (
          <nav class="site-nav" aria-label="Main">
            <a class="nav-wide" href="/#profile">Profiles</a>
            <a class="nav-wide" href="/#dashboard">Therapy dashboard</a>
            <a class="nav-wide" href="/pricing">Pricing</a>
            <a class="nav-wide" href={`${config.appOrigin}/auth/login`}>Sign in</a>
            <a class="btn small-btn" href="/join">Create{" "}<span class="nav-wide-text">your{" "}</span>profile</a>
            <details class="site-menu">
              <summary aria-label="Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
              </summary>
              <div class="site-menu-panel">
                <a href="/#profile">Profiles</a>
                <a href="/#dashboard">Therapy dashboard</a>
                <a href="/pricing">Pricing</a>
                <a href={`${config.appOrigin}/auth/login`}>Sign in</a>
              </div>
            </details>
          </nav>
        )}
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <span class="muted">© Therapysts</span>
      <a href={`${config.marketingOrigin}/terms`}>Terms</a>
      <a href={`${config.marketingOrigin}/privacy`}>Privacy</a>
    </footer>
  </div>
</Base>
