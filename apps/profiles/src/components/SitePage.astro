---
/*
 * The frame for the site's own pages (home, report, not found, no longer
 * available): the Therapysts top bar and footer around the page content.
 * Profile pages use ProfileView instead, where the therapist leads.
 */
import Base from './Base.astro';
import lockup from '@therapysts/ui/src/brand/therapysts/logos/therapysts-lockup.min.svg?url';
import { config as loadConfig } from '../lib/env';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  theme?: string;
  /** Show "Sign in" and "Create your profile" in the top bar (the home page). */
  fullNav?: boolean;
  /** Served on the app's domain (DeskHome, pricing): links stay on that domain. */
  desk?: boolean;
}
const { title, description, canonical, noindex = false, theme = 'calm', fullNav = false, desk = false } = Astro.props;
const config = loadConfig();
---
<Base title={title} description={description} canonical={canonical} noindex={noindex} theme={theme}>
  <div class="site">
    <header class="site-top">
      <div class="site-top-inner">
        <a class="brand" href="/" aria-label="Therapysts home">
          <img src={lockup} alt="therapysts" width="146" height="36" />
        </a>
        {fullNav && desk && (
          <nav class="site-nav" aria-label="Main">
            <a class="nav-wide" href="/#features">Features</a>
            <a class="nav-wide" href={`${config.publicOrigin}/`}>Profiles</a>
            <a class="nav-wide" href="/pricing">Pricing</a>
            <a class="nav-wide" href="/login">Sign in</a>
            <a class="btn small-btn" href="/signup">Start free</a>
            <details class="site-menu">
              <summary aria-label="Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
              </summary>
              <div class="site-menu-panel">
                <a href="/#features">Features</a>
                <a href={`${config.publicOrigin}/`}>Profiles</a>
                <a href="/pricing">Pricing</a>
                <a href="/login">Sign in</a>
              </div>
            </details>
          </nav>
        )}
        {fullNav && !desk && (
          <nav class="site-nav" aria-label="Main">
            <a class="nav-wide" href="/#features">Why a profile</a>
            <a class="nav-wide" href={`${config.appOrigin}/`}>For practices</a>
            <a class="nav-wide" href={`${config.appOrigin}/login`}>Sign in</a>
            <a class="btn small-btn" href="/join">Create your profile</a>
            <details class="site-menu">
              <summary aria-label="Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
              </summary>
              <div class="site-menu-panel">
                <a href="/#features">Why a profile</a>
                <a href={`${config.appOrigin}/`}>For practices</a>
                <a href={`${config.appOrigin}/login`}>Sign in</a>
              </div>
            </details>
          </nav>
        )}
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <span class="muted">© Therapysts · Run by EDGD Media Digital Solutions Ltd</span>
      <a href={`${config.publicOrigin}/terms`}>Terms</a>
      <a href={`${config.publicOrigin}/privacy`}>Privacy</a>
      <a href={`mailto:${config.contactEmail}`}>Contact</a>
    </footer>
  </div>
</Base>
