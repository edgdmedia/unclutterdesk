{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "therapysts-profiles",
  // Our own entry (spec §6.16): Astro's handler as the default export, plus
  // the PracticeHost entrypoint that only the tenant router's binding reaches.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  // ctx.exports (on by default since 2025-11-17) lets POST /api/purge reach
  // the PracticeHost entrypoint's cache (src/worker.ts, spec §6.16).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Workers Caching (spec §4.2, §6.12): pages are cached by this Worker, keyed
  // by URL and Worker version (never cookies), tagged per profile, and purged
  // from inside the Worker by POST /api/purge (src/pages/api/purge.ts).
  "cache": { "enabled": true },
  // Secret, not a var: PROFILES_PURGE_SECRET, shared with the API's
  // profile.purge job. Set with: pnpm exec wrangler secret put PROFILES_PURGE_SECRET
  // Profiles live on their target domain from the start (spec §4.1b), as a
  // Workers Custom Domain on the therapysts.com zone in the new account.
  "routes": [{ "pattern": "therapysts.com", "custom_domain": true }],

  // "Report this profile" (spec §6.15): at most 5 reports a minute from one
  // visitor IP, counted at the edge before the API is called. The IP is only
  // the counter's key; it is never stored or forwarded.
  "ratelimits": [{ "name": "REPORT_LIMITER", "namespace_id": "1501", "simple": { "limit": 5, "period": 60 } }],

  // Domain config (spec §4.1a): this site's addresses.
  "vars": {
    "PROFILE_PUBLIC_URL": "https://therapysts.com",
    "API_URL": "https://api.therapysts.app",
    "APP_URL": "https://therapysts.app",
    "MEDIA_URL": "https://media.therapysts.com",
    // support@, privacy@ and security@ on the legal pages and Contact.
    "CONTACT_EMAIL_DOMAIN": "therapysts.com"
  }
}
