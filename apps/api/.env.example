# Settings added in v2. The full list of API settings, with production values
# described, is in docs/VPS_PREPARATION.md.

# Shared with the tenant router (set there as a Worker secret). The API trusts
# the router's custom-domain /api proxy headers (practice, visitor IP) only
# when this matches. Any long random string, e.g. `openssl rand -hex 32`.
ROUTER_PROXY_SECRET=

# Domain settings (spec §4.1a). Each defaults to today's production address,
# so leave them unset until the domain move (§4.1b).
# TENANT_ROOT_DOMAIN=unclutterdesk.com        # practice subdomains {slug}.<root>; also the CSRF cookie domain
# MARKETING_URL=https://unclutterdesk.com     # CORS also allows its www.
# APP_URL=https://app.unclutterdesk.com       # its own setting, never derived from the root
# API_URL=https://api.unclutterdesk.com
# PROFILE_PUBLIC_URL=https://profiles.unclutterdesk.com
# COOKIE_DOMAIN=                              # overrides .<TENANT_ROOT_DOMAIN>
# MAIL_FROM=                                  # platform sender; default no-reply@<TENANT_ROOT_DOMAIN>
# CUSTOM_DOMAIN_TARGET=customers.unclutterdesk.com  # CLOUDFLARE_SAAS_CNAME_TARGET is read when unset

# File storage on Cloudflare R2 (spec §4.4). Create the buckets in the account
# that owns the new domains (docs/DOMAIN_MOVE.md), so the public bucket can use
# a custom domain there. Without these, storage work waits in the job queue.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=                           # published-profile photos and preview images
# R2_PRIVATE_BUCKET=                          # credential documents (Phase 3); never public
# R2_PUBLIC_URL=                              # the public bucket's custom domain, https://media.<marketing domain>

# Shared with the public profile site (set there as a Worker secret). The API's
# profile.purge job sends it to the site's POST /api/purge after a published
# profile changes (spec §6.12). Until it is set, purge jobs wait in the queue.
# PROFILES_PURGE_SECRET=

# Unclutter Journal (docs/design/journal-integration.md). The same secret is set
# on the Suite API (32+ characters). Until it is set, nothing about Journal shows.
# Development points JOURNAL_API_URL and JOURNAL_APP_URL at the Suite's test
# environment; the defaults are production.
# DESK_INTEGRATION_SECRET=
# JOURNAL_API_URL=https://api.unclutter.com.ng/v1
# JOURNAL_APP_URL=https://journal.unclutter.com.ng
