# Settings added in v2. The full list of API settings, with production values
# described, is in docs/VPS_PREPARATION.md.

# Shared with the tenant router (set there as a Worker secret). The API trusts
# the router's custom-domain /api proxy headers (practice, visitor IP) only
# when this matches. Any long random string, e.g. `openssl rand -hex 32`.
ROUTER_PROXY_SECRET=

# Domain settings (spec §4.1a). Each defaults to today's production address,
# so leave them unset until the domain move (§4.1b).
# TENANT_ROOT_DOMAIN=unclutterdesk.com        # practice subdomains {slug}.<root>; also the CSRF cookie domain
# MARKETING_URL=https://unclutterdesk.com     # CORS also allows its www.
# APP_URL=https://app.unclutterdesk.com       # its own setting, never derived from the root
# API_URL=https://api.unclutterdesk.com
# PROFILE_PUBLIC_URL=https://profiles.unclutterdesk.com
# COOKIE_DOMAIN=                              # overrides .<TENANT_ROOT_DOMAIN>
# MAIL_FROM=                                  # platform sender; default no-reply@<TENANT_ROOT_DOMAIN>
# CUSTOM_DOMAIN_TARGET=customers.unclutterdesk.com  # CLOUDFLARE_SAAS_CNAME_TARGET is read when unset
