{
  "_comment": "Client-facing API routes the /api proxy forwards on practice custom domains (spec §6.16). Everything else is refused. Paths are the API's own (without /api); :name matches one path segment. apps/api/src/router-proxy/client-api-routes.spec.ts checks every entry exists and is public or client-reachable, never admin, platform or dashboard.",
  "routes": [
    "GET /v1/tenant/public/info",
    "GET /v1/tenant/public/info/:slugOrDomain",
    "GET /v1/tenant/public/exists/:slugOrDomain",
    "GET /v1/tenant/:id/logo",

    "POST /v1/auth/login",
    "POST /v1/auth/logout",
    "POST /v1/auth/refresh",
    "POST /v1/auth/client-signup",
    "POST /v1/auth/client-set-password",
    "POST /v1/auth/verify-email",
    "POST /v1/auth/resend-verification",
    "POST /v1/auth/forgot-password",
    "POST /v1/auth/reset-password",
    "GET /v1/auth/status",
    "GET /v1/auth/preferences",
    "PUT /v1/auth/preferences",
    "POST /v1/auth/change-password",
    "GET /v1/auth/sessions",
    "POST /v1/auth/sessions/revoke-others",
    "DELETE /v1/auth/sessions/:id",
    "POST /v1/auth/me/tour-complete",

    "GET /v1/consult/public/therapists",
    "GET /v1/consult/public/services",
    "GET /v1/consult/public/availability",
    "GET /v1/consult/public/payment-options",
    "POST /v1/consult/public/bookings",
    "POST /v1/consult/public/bookings/:bookingId/confirm-payment",
    "POST /v1/consult/public/bookings/:bookingId/transfer-sent",
    "GET /v1/consult/public/bookings/:bookingId/pay-link",
    "POST /v1/consult/public/bookings/:bookingId/pay-link",
    "POST /v1/consult/public/bookings/:bookingId/pay",
    "POST /v1/discount/validate",

    "GET /v1/consult/portal",
    "GET /v1/consult/portal/payments",
    "GET /v1/consult/portal/bookings/:bookingId/reschedule-options",
    "POST /v1/consult/portal/bookings/:bookingId/reschedule",
    "GET /v1/calendar/bookings/:bookingId/ical",

    "GET /v1/intake/public/forms",
    "GET /v1/intake/public/reviews",
    "POST /v1/intake/public/submissions",
    "GET /v1/intake/mine/forms",
