{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unclutterdesk-tenant-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // No routes here, on purpose. `wrangler deploy` replaces the Worker's routes
  // with whatever this file lists, so a deploy used to delete every practice's
  // custom-domain route (each created by the API when the practice saves its
  // domain) and those sites answered 522. Routes are owned by the API instead:
  // the custom-domain cron (apps/api/src/modules/tenant/custom-domain.cron.ts)
  // keeps `*.<TENANT_ROOT_DOMAIN>/*` and every provisioned domain's route in
  // place. workers_dev stays off, as Wrangler would otherwise turn it on.
  //
  // `api.<root>` must keep its more specific route with Worker = None in
  // Cloudflare (more specific routes win); without it the Worker answers
  // `api` with a 404 rather than the SPA.
  "workers_dev": false,

  // Domain config (spec §4.1a): the vars below are this Worker's production
  // addresses. Change them here at the domain move.
  "vars": {
    "APEX_HOST": "unclutterdesk.com",
    // Linked from the practice-not-found page.
    "MARKETING_URL": "https://unclutterdesk.com",
    // The app Pages project's .pages.dev hostname. Verify this matches the
    // CLOUDFLARE_PAGES_APP_PROJECT secret used by .github/workflows/deploy-app.yml.
    "ORIGIN_HOST": "app-unclutterdesk.pages.dev",
    "API_BASE": "https://api.unclutterdesk.com"
  }
  // Secret, not a var: ROUTER_PROXY_SECRET, shared with the API for the
  // custom-domain /api proxy (spec §6.16). Set with
  //   pnpm exec wrangler secret put ROUTER_PROXY_SECRET
}
