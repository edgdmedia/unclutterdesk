{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unclutterdesk-tenant-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // No routes here, on purpose. `wrangler deploy` replaces the Worker's routes
  // with whatever this file lists, so a deploy used to delete every practice's
  // custom-domain route (each created by the API when the practice saves its
  // domain) and those sites answered 522. Routes are owned by the API instead:
  // the custom-domain cron (apps/api/src/modules/tenant/custom-domain.cron.ts)
  // keeps `*.<TENANT_ROOT_DOMAIN>/*` and every provisioned domain's route in
  // place. workers_dev stays off, as Wrangler would otherwise turn it on.
  //
  // `api.<root>` must keep its more specific route with Worker = None in
  // Cloudflare (more specific routes win); without it the Worker answers
  // `api` with a 404 rather than the SPA.
  "workers_dev": false,

  // §6.16: a solo practice's `/` is the owner's profile page, rendered by the
  // profiles Worker's PracticeHost entrypoint. A service binding needs both
  // Workers in the same Cloudflare account.
  "services": [{ "binding": "PROFILES", "service": "therapysts-profiles", "entrypoint": "PracticeHost" }],

  // Domain config (spec §4.1a): the vars below are this Worker's production
  // addresses. Change them here at the domain move.
  "vars": {
    // Practice subdomains are {slug}.therapysts.app (spec §4.1b).
    "APEX_HOST": "therapysts.app",
    // The app is the bare domain, served by its Pages custom domain; app. and
    // www. redirect there (router.ts).
    "APP_HOST": "therapysts.app",
    // Linked from the practice-not-found page. Stays on the current marketing
    // site until apps/landing merges into apps/profiles (therapysts.com).
    "MARKETING_URL": "https://unclutterdesk.com",
    // The app Pages project's .pages.dev hostname, in the Therapysts account.
    // Verify this matches the CLOUDFLARE_PAGES_APP_PROJECT secret used by
    // .github/workflows/deploy-app.yml (docs/runbooks/therapysts-app-move.md).
    "ORIGIN_HOST": "therapysts-app.pages.dev",
    "API_BASE": "https://api.therapysts.app"
  }
  // Secret, not a var: ROUTER_PROXY_SECRET, shared with the API for the
  // custom-domain /api proxy (spec §6.16). Set with
  //   pnpm exec wrangler secret put ROUTER_PROXY_SECRET
}
