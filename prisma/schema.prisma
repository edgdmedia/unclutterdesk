generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Multi-Tenant Core ────────────────────────────────────────────────────────

model Tenant {
  id                BigInt   @id @default(autoincrement())
  name              String   @db.VarChar(100)
  slug              String   @unique @db.VarChar(50) // e.g., "dr-jane" -> dr-jane.unclutterdesk.com
  customDomain      String?  @unique @db.VarChar(100) // e.g., "booking.drjanetherapy.com"
  customDomainStatus String   @default("PENDING") @db.VarChar(20) // "PENDING", "ACTIVE", "FAILED"
  
  // White-Label Brand Tokens
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String   @default("#0F3A53") @db.VarChar(20)
  secondaryColor    String   @default("#E3B341") @db.VarChar(20)
  currency          String   @default("NGN") @db.VarChar(10)
  
  // Policies & Content
  cancellationHours Int      @default(24)
  shortName         String?
  welcomeTitle      String?
  welcomeMessage    String?
  publicEmail       String?
  publicPhone       String?
  city              String?
  address           String?
  category          String?
  
  subscriptionTier  String   @default("STARTER") // "STARTER", "PRO", "CLINIC"
  isActive          Boolean  @default(true)

  // Account closure. Requesting closure deactivates the practice immediately
  // and starts the retention window; the irreversible purge is a separate,
  // platform-operated step so there is time to export or change course.
  closureRequestedAt DateTime?
  closureRequestedBy BigInt?

  // Stripe Billing
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Notification plug-in: which channels this tenant has enabled at all.
  // JSON map, e.g. { "email": true, "in_app": true, "push": true, "sms": false }
  notificationChannels Json     @default("{\"in_app\":true,\"email\":true,\"push\":true,\"sms\":false}")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profiles                Profile[]
  therapists              ConsultTherapistProfile[]
  notifications           Notification[]
  notificationDispatches  NotificationDispatch[]
  notificationPreferences NotificationPreference[]
  emailLogs               EmailLog[]
  pushSubscriptions       WebPushSubscription[]
  services          ConsultService[]
  availabilities    ConsultAvailability[]
  bookings          ConsultBooking[]
  discountCodes     DiscountCode[]
  pendingInvites       ConsultPendingInvite[]
  universalForms       UniversalForm[]
  universalSubmissions UniversalFormSubmission[]
  clinicalNotes        ClinicalNote[]
  bankSubaccount    BankSubaccount?

  @@index([slug])
  @@index([customDomain])
}

// ── User & Profile ─────────────────────────────────────────────────────────

model User {
  id                  BigInt    @id @default(autoincrement())
  email               String    @unique
  username            String    @unique
  password            String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  platformRole        String?   // "SUPER_ADMIN", "ADMIN" — platform-level staff, no tenant context
  profiles            Profile[]
  tokens              Token[]
}

model Token {
  id         String    @id
  userId     BigInt
  type       String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([type, expiresAt])
}

model Profile {
  id              BigInt    @id @default(autoincrement())
  tenantId        BigInt
  userId          BigInt?
  username        String
  email           String
  type            String    @default("user") // "user", "therapist", "admin"
  role            String    @default("CLIENT") // "OWNER", "ADMIN", "RECEPTIONIST", "THERAPIST", "CLIENT"
  permissions     String[]  @default([])
  status          String    @default("active") // "active", "inactive", "pending"
  firstName       String?
  lastName        String?
  phone           String?
  gender          String?
  dateOfBirth     DateTime?
  avatarUrl       String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User?                    @relation(fields: [userId], references: [id])
  consultTherapistProfile ConsultTherapistProfile?
  clientBookings          ConsultBooking[]         @relation("ClientBookings")
  notifications           Notification[]
  notificationDispatches  NotificationDispatch[]
  notificationPreferences NotificationPreference[]
  emailLogs               EmailLog[]
  pushSubscriptions       WebPushSubscription[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, status])
}

// ── Therapist Profile ────────────────────────────────────────────────────────

model ConsultTherapistProfile {
  profileId             BigInt   @id
  tenantId              BigInt
  publicUsername        String?  @db.VarChar(50)
  bookingEmail          String?
  notificationEmail     String?
  welcomeMessage        String?
  specialty             String?
  modalities            String[] @default([])
  credentials           String?
  yearsExperience       Int?
  languages             String[] @default([])
  isPublic              Boolean  @default(true)
  acceptsGeneralBooking Boolean  @default(true)
  videoProvider         String?  @default("JITSI") // "JITSI", "DAILY", "GOOGLE_MEET", "ZOOM"
  dailyApiKey           String?
  googleRefreshToken    String?
  isVerified            Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile               Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  availabilities        ConsultAvailability[]

  @@unique([tenantId, profileId])
  @@unique([tenantId, publicUsername])
  @@index([tenantId, isPublic])
}

// ── Services & Scheduling ───────────────────────────────────────────────────

model ConsultService {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt
  title           String
  description     String?
  durationMinutes Int      @default(50)
  priceKobo       BigInt   @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime?

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  availabilities  ConsultAvailability[]
  bookings        ConsultBooking[]

  @@index([tenantId, isActive])
}

model ConsultAvailability {
  id                BigInt   @id @default(autoincrement())
  tenantId          BigInt
  providerProfileId BigInt
  serviceId         BigInt?
  startsAt          DateTime
  endsAt            DateTime
  channel           String   @default("VIDEO")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  therapist         ConsultTherapistProfile @relation(fields: [providerProfileId], references: [profileId], onDelete: Cascade)
  service           ConsultService?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  bookings          ConsultBooking[]

  @@index([tenantId, providerProfileId, startsAt, isActive])
}

model ConsultBooking {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt
  serviceId       BigInt
  availabilityId  BigInt
  clientProfileId BigInt
  status          String    @default("PENDING_PAYMENT") // "PENDING_PAYMENT", "CONFIRMED", "COMPLETED", "CANCELLED"
  paymentRef      String?   @unique
  paidAt          DateTime?
  notes           String?
  videoRoomName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime?

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service         ConsultService      @relation(fields: [serviceId], references: [id])
  availability    ConsultAvailability @relation(fields: [availabilityId], references: [id])
  client          Profile             @relation("ClientBookings", fields: [clientProfileId], references: [id])
  formSubmissions UniversalFormSubmission[]
  clinicalNotes   ClinicalNote[]

  @@index([tenantId, clientProfileId])
  @@index([tenantId, status])
}

model DiscountCode {
  id                 BigInt    @id @default(autoincrement())
  tenantId           BigInt
  code               String
  label              String?
  discountType       String    @default("PERCENT") // "PERCENT" | "FIXED"
  discountPercent    Int?      // 1–100
  discountAmountKobo BigInt?
  maxUses            Int?
  usedCount          Int       @default(0)
  expiresAt          DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

model ConsultPendingInvite {
  id         BigInt   @id @default(autoincrement())
  tenantId   BigInt
  email      String
  role       String   @default("THERAPIST") // "ADMIN", "RECEPTIONIST", "THERAPIST"
  claimToken String   @unique
  sentAt     DateTime @default(now())
  expiresAt  DateTime

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

// ── Universal Form & Assessment Builder Engine ───────────────────────────

model UniversalForm {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt
  title       String
  slug        String?
  systemKey   String?
  description String?
  targetType  String   @default("INTAKE") // "INTAKE", "ASSESSMENT", "FEEDBACK", "CONSENT", "REVIEW"
  schemaJson  Json     // Field array: { id, label, type: 'text'|'textarea'|'single_choice'|'multiple_choice'|'scale'|'signature'|'file_upload', required, options }
  reviewPublicationMode String @default("MANUAL") // "MANUAL", "AUTO"
  reviewerDisplayMode   String @default("FIRST_NAME") // "FIRST_NAME", "ANONYMOUS"
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions UniversalFormSubmission[]

  @@index([tenantId, targetType])
}

model UniversalFormSubmission {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt
  formId          BigInt
  bookingId       BigInt?
  clientProfileId BigInt
  targetType      String   @default("INTAKE")
  status          String   @default("UNREAD") // "UNREAD", "REVIEWED", "PUBLISHED", "HIDDEN"
  answersJson     Json     // Key-value map of question ID -> answer or signature data
  derivedJson     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime?
  reviewedAt      DateTime?
  publishedAt     DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form            UniversalForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  booking         ConsultBooking? @relation(fields: [bookingId], references: [id])

  @@index([tenantId, bookingId])
  @@index([tenantId, clientProfileId])
}

// ── Clinical Notes & SOAP Records ──────────────────────────────────────────

model ClinicalNote {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt
  bookingId       BigInt?
  clientProfileId BigInt
  authorProfileId BigInt
  subjective      String?  @db.Text
  objective       String?  @db.Text
  assessment      String?  @db.Text
  plan            String?  @db.Text
  diagnosisCode   String?
  isLocked        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking         ConsultBooking? @relation(fields: [bookingId], references: [id])

  @@index([tenantId, bookingId])
  @@index([tenantId, clientProfileId])
}

// ── Bank Subaccount & Payout Billing ───────────────────────────────────────

model BankSubaccount {
  id               BigInt   @id @default(autoincrement())
  tenantId         BigInt   @unique
  bankCode         String
  bankName         String
  accountNumber    String
  accountName      String
  paystackCode     String?
  stripeAccountId  String?  @unique
  isVerified       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ── Notifications & Messaging ────────────────────────────────────────────────
// Notification system: in-app rows, a dispatch queue (immediate + scheduled
// reminders), per-profile channel preferences, an email delivery log, and
// web-push subscriptions. Tenants opt into channels via `notificationChannels`.

model Notification {
  id          BigInt   @id @default(autoincrement())
  tenantId    BigInt
  profileId   BigInt
  type        String // e.g. "consult.booking_confirmed", "billing.receipt"
  title       String
  message     String
  link        String?
  actionLabel String?
  data        Json?
  status      String   @default("unread") // "unread", "read", "archived"
  readAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile  Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dispatch NotificationDispatch?

  @@index([profileId, status])
  @@index([profileId, createdAt])
  @@index([tenantId, createdAt])
}

model NotificationDispatch {
  id             BigInt    @id @default(autoincrement())
  tenantId       BigInt
  profileId      BigInt
  type           String // module/event, e.g. "consult.reminder"
  title          String
  message        String
  link           String?
  actionLabel    String?
  data           Json?
  category       String? // "activity", "digests", "reminders"
  channels       Json? // effective per-channel booleans: { in_app, email, push, sms }
  status         String    @default("PENDING") // "PENDING", "PROCESSING", "SENT", "PARTIAL", "FAILED", "CANCELLED"
  triggerAt      DateTime  @default(now())
  sentAt         DateTime?
  attempts       Int       @default(0)
  dedupeKey      String?
  lastError      String?
  notificationId BigInt?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id])

  @@unique([dedupeKey])
  @@index([status, triggerAt])
  @@index([tenantId, profileId])
}

model NotificationPreference {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt
  profileId BigInt
  module    String // "notification", "consult", "billing", ...
  category  String? // "activity", "digests", "reminders"
  channel   String // "in_app", "email", "push", "sms"
  enabled   Boolean @default(true)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, module, category, channel])
  @@index([profileId])
  @@index([tenantId])
}

model EmailLog {
  id         BigInt    @id @default(autoincrement())
  tenantId   BigInt
  profileId  BigInt
  type       String // module/event
  to         String
  subject    String
  providerId String? // SMTP messageId
  status     String // "SENT", "FAILED", "SKIPPED"
  error      String?
  createdAt  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([profileId, createdAt])
}

model WebPushSubscription {
  id         BigInt    @id @default(autoincrement())
  tenantId   BigInt
  profileId  BigInt
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  isActive   Boolean   @default(true)
  lastError  String?
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
